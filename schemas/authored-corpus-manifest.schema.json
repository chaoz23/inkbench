{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chaoz23/inkbench/blob/v0.2.0/schemas/authored-corpus-manifest.schema.json",
  "title": "InkBench authored-project corpus manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tier", "corpusVersion", "source", "cases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "tier": { "const": "authored-project" },
    "corpusVersion": { "const": "authored-corpus-v1" },
    "source": {
      "type": "object",
      "required": ["repository", "commit", "manifestPath"]
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "family", "projectSize", "directory", "source", "compiled", "files"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "family": { "enum": ["function-and-loop-heavy", "choice-dense-authored-story", "stitch-heavy-random-authored-story"] },
          "projectSize": { "enum": ["small", "medium", "large"] },
          "directory": { "type": "string", "minLength": 1 },
          "source": {
            "type": "object",
            "required": ["name", "author", "license", "repository", "commit", "licenseFile", "licenseSha256", "entrypoint", "randomness", "compileSetup", "structuralMeasures"]
          },
          "compiled": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "sha256", "compiler", "compilerVersion", "arguments", "provenance"],
            "properties": {
              "file": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "compiler": { "const": "inklecate" },
              "compilerVersion": { "type": "string", "minLength": 1 },
              "arguments": { "type": "array", "items": { "type": "string" } },
              "provenance": { "type": "string", "minLength": 1 }
            }
          },
          "files": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        }
      }
    }
  }
}
