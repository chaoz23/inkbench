{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chaoz23/inkbench/blob/v0.1.0/schemas/mutant-experiment-config.schema.json",
  "title": "InkBench authored-planted experiment config v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "storyIds", "algorithms", "searchSeeds", "budgets", "storySeed"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "storyIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["the-intercept-20"] }
    },
    "algorithms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["random", "systematic", "coverage", "swarm", "inkcheck"] }
    },
    "searchSeeds": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0 } },
    "budgets": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } },
    "storySeed": { "type": "integer", "minimum": 1 },
    "inkcheckCommand": { "type": "string", "minLength": 1 },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxMemoryMb": { "type": "integer", "minimum": 1 },
        "maxTimeMs": { "type": "integer", "minimum": 1 },
        "progressIntervalTransitions": { "type": "integer", "minimum": 1 },
        "progressIntervalMs": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
