{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chaoz23/inkbench/blob/v0.1.0/schemas/experiment-config.schema.json",
  "title": "InkBench experiment configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "families", "algorithms", "fixtureSeeds", "searchSeeds", "budgets", "difficulty", "storySeed"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "families": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/family" }
    },
    "algorithms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["random", "systematic", "coverage", "swarm", "inkcheck"] }
    },
    "fixtureSeeds": { "$ref": "#/$defs/positiveIntegers" },
    "searchSeeds": { "$ref": "#/$defs/nonnegativeIntegers" },
    "budgets": { "$ref": "#/$defs/positiveIntegers" },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 10 },
    "storySeed": { "type": "integer", "minimum": 1 },
    "inkcheckCommand": { "type": "string", "minLength": 1 },
    "resources": { "$ref": "#/$defs/resources" }
  },
  "$defs": {
    "family": {
      "enum": ["shallow-obvious", "deep-corridor", "rare-prefix", "combination-lock", "loop-count", "revisit-after-mutation", "novelty-honeypot", "false-novelty", "delayed-consequence", "order-dependent", "compound-needle"]
    },
    "positiveIntegers": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer", "minimum": 1 }
    },
    "nonnegativeIntegers": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer", "minimum": 0 }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxMemoryMb": { "type": "integer", "minimum": 1 },
        "maxTimeMs": { "type": "integer", "minimum": 1 },
        "progressIntervalTransitions": { "type": "integer", "minimum": 1 },
        "progressIntervalMs": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
