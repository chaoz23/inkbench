{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chaoz23/inkbench/blob/main/schemas/run-report.schema.json",
  "title": "InkBench run report v2",
  "type": "object",
  "required": ["schemaVersion", "runId", "fixtureId", "fixtureGeneratorVersion", "fixtureSourceSha256", "benchmarkTier", "family", "algorithm", "algorithmVersion", "fixtureSeed", "searchSeed", "storySeed", "difficulty", "dimensions", "budget", "counts", "coverage", "coverageItems", "discoveredBugs", "runtimeFindings", "plantedBugIds", "timing", "stopReason", "resources", "runtime", "status", "error", "notes"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "runId": { "type": "string" },
    "fixtureId": { "type": "string" },
    "fixtureGeneratorVersion": { "type": "string" },
    "fixtureSourceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "benchmarkTier": { "enum": ["generated-planted", "authored-project"] },
    "family": { "type": "string" },
    "algorithm": { "enum": ["random", "systematic", "coverage", "swarm", "inkcheck"] },
    "algorithmVersion": { "type": "string" },
    "fixtureSeed": { "type": "integer" },
    "searchSeed": { "type": "integer" },
    "storySeed": { "type": "integer", "minimum": 1 },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 10 },
    "dimensions": { "type": "object" },
    "budget": {
      "type": "object",
      "required": ["unit", "limit"],
      "properties": {
        "unit": { "enum": ["choice-transitions", "inkcheck-states"] },
        "limit": { "type": "integer", "minimum": 1 }
      }
    },
    "counts": {
      "type": "object",
      "required": ["transitions", "launches", "rootLaunches", "episodesCompleted"],
      "properties": {
        "transitions": { "type": "integer", "minimum": 0 },
        "launches": { "type": "integer", "minimum": 0 },
        "rootLaunches": { "type": "integer", "minimum": 0 },
        "episodesCompleted": { "type": "integer", "minimum": 0 }
      }
    },
    "coverage": { "type": ["object", "null"] },
    "coverageItems": {
      "type": ["object", "null"],
      "properties": {
        "locations": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "choices": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "edges": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "semanticStates": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "discoveredBugs": { "type": "array", "items": { "type": "object" } },
    "runtimeFindings": { "type": "array", "items": { "type": "object" } },
    "plantedBugIds": { "type": "array", "items": { "type": "string" } },
    "timing": { "type": "object" },
    "stopReason": { "enum": ["budget", "search-exhausted", "memory", "time", "cancelled", "error"] },
    "resources": {
      "type": ["object", "null"],
      "required": ["limits", "stopReason", "process", "snapshots", "coverageIndexBytes", "peakCoverageIndexBytes"],
      "properties": {
        "limits": {
          "type": "object",
          "required": ["memoryCapBytes", "timeCapMs"],
          "properties": {
            "memoryCapBytes": { "type": "integer", "minimum": 1 },
            "timeCapMs": { "type": ["integer", "null"], "minimum": 1 }
          }
        },
        "stopReason": { "enum": ["budget", "search-exhausted", "memory", "time", "cancelled", "error"] },
        "process": { "type": "object", "required": ["peak", "final"] },
        "snapshots": { "type": "object", "required": ["created", "released", "current", "peak", "explicitReferences", "currentBytes", "peakBytes", "checkpointBytes", "peakCheckpointBytes"] },
        "coverageIndexBytes": { "type": "integer", "minimum": 0 },
        "peakCoverageIndexBytes": { "type": "integer", "minimum": 0 }
      }
    },
    "runtime": {
      "type": "object",
      "required": ["harnessVersion", "runContractVersion", "engine", "engineVersion", "node", "platform"],
      "properties": {
        "harnessVersion": { "type": "string" },
        "runContractVersion": { "const": "resource-bounded-v2" },
        "engine": { "type": "string" },
        "engineVersion": { "type": "string" },
        "node": { "type": "string" },
        "platform": { "type": "string" }
      }
    },
    "status": { "enum": ["completed", "resource-stopped", "adapter-unavailable", "compile-error", "runtime-error"] },
    "error": { "type": ["string", "null"] },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
