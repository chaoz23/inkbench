{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chaoz23/inkbench/blob/main/schemas/run-report.schema.json",
  "title": "InkBench run report v4",
  "type": "object",
  "required": ["schemaVersion", "runId", "fixtureId", "fixtureGeneratorVersion", "fixtureSourceSha256", "benchmarkTier", "family", "algorithm", "algorithmVersion", "executionFingerprint", "observability", "fixtureSeed", "searchSeed", "storySeed", "difficulty", "dimensions", "budget", "workBudget", "counts", "coverage", "coverageItems", "discoveredBugs", "runtimeFindings", "plantedBugIds", "discoveryTimingBasis", "timing", "parallelism", "stopReason", "resources", "runtime", "status", "error", "notes"],
  "properties": {
    "schemaVersion": { "const": 4 },
    "runId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "fixtureId": { "type": "string" },
    "fixtureGeneratorVersion": { "type": "string" },
    "fixtureSourceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "benchmarkTier": { "enum": ["generated-planted", "authored-planted", "authored-project"] },
    "family": { "type": "string" },
    "algorithm": { "enum": ["random", "systematic", "coverage", "swarm", "inkcheck"] },
    "algorithmVersion": { "type": "string" },
    "executionFingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "digest", "harnessArtifactSha256", "packageLockSha256", "algorithmVersion", "algorithmArtifactSha256", "externalCommandSha256", "node", "v8", "platform", "inkRuntimeVersion", "compilerArtifactSha256"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "harnessArtifactSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "packageLockSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "algorithmVersion": { "type": "string" },
        "algorithmArtifactSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "externalCommandSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "node": { "type": "string" },
        "v8": { "type": "string" },
        "platform": { "type": "string" },
        "inkRuntimeVersion": { "type": "string" },
        "compilerArtifactSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "observability": {
      "type": "object",
      "required": ["informationRegime", "instrumentationRegime", "commonCoverageCharged", "observableFields", "sourcePrivileges"],
      "properties": {
        "informationRegime": { "enum": ["runtime-observation", "compiled-artifact", "full-source"] },
        "instrumentationRegime": { "enum": ["inkbench-common", "external-native", "external-private-signal"] },
        "commonCoverageCharged": { "type": "boolean" },
        "observableFields": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "sourcePrivileges": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "fixtureSeed": { "type": "integer" },
    "searchSeed": { "type": "integer" },
    "storySeed": { "type": "integer", "minimum": 1 },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 10 },
    "dimensions": { "type": "object" },
    "budget": {
      "type": "object",
      "required": ["unit", "limit"],
      "properties": {
        "unit": { "enum": ["choice-transitions", "inkcheck-states", "wall-ms"] },
        "limit": { "type": "integer", "minimum": 1 }
      }
    },
    "workBudget": {
      "type": ["object", "null"],
      "required": ["unit", "limit"],
      "properties": {
        "unit": { "enum": ["choice-transitions", "inkcheck-states"] },
        "limit": { "type": "integer", "minimum": 1 }
      }
    },
    "counts": {
      "type": "object",
      "required": ["transitions", "launches", "rootLaunches", "episodesCompleted"],
      "properties": {
        "transitions": { "type": "integer", "minimum": 0 },
        "launches": { "type": "integer", "minimum": 0 },
        "rootLaunches": { "type": "integer", "minimum": 0 },
        "episodesCompleted": { "type": "integer", "minimum": 0 }
      }
    },
    "coverage": { "type": ["object", "null"] },
    "coverageItems": {
      "type": ["object", "null"],
      "properties": {
        "locations": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "choices": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "edges": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "semanticStates": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "discoveredBugs": { "type": "array", "items": { "type": "object" } },
    "runtimeFindings": { "type": "array", "items": { "type": "object" } },
    "plantedBugIds": { "type": "array", "items": { "type": "string" } },
    "discoveryTimingBasis": { "enum": ["global-work", "global-wall", "final-only"] },
    "timing": {
      "type": "object",
      "required": ["wallMs", "cpuMs", "discoveryTimeOrigin", "phases"],
      "properties": {
        "wallMs": { "type": "number", "minimum": 0 },
        "cpuMs": { "type": ["number", "null"], "minimum": 0 },
        "discoveryTimeOrigin": { "enum": ["search-active", "tool-global", "final-report"] },
        "externalProcessWallMs": { "type": "number", "minimum": 0 },
        "phases": {
          "type": "object",
          "required": ["setupMs", "compileLoadMs", "adapterStartupMs", "searchMs", "scoringMs", "replayScoringMs", "evidenceSerializationMs", "finalizationMs"],
          "properties": {
            "setupMs": { "type": ["number", "null"], "minimum": 0 },
            "compileLoadMs": { "type": ["number", "null"], "minimum": 0 },
            "adapterStartupMs": { "type": ["number", "null"], "minimum": 0 },
            "searchMs": { "type": ["number", "null"], "minimum": 0 },
            "scoringMs": { "type": ["number", "null"], "minimum": 0 },
            "replayScoringMs": { "type": ["number", "null"], "minimum": 0 },
            "evidenceSerializationMs": { "type": ["number", "null"], "minimum": 0 },
            "finalizationMs": { "type": ["number", "null"], "minimum": 0 }
          }
        }
      }
    },
    "parallelism": {
      "type": "object",
      "required": ["requested", "effective", "mode"],
      "properties": {
        "requested": { "type": ["integer", "string", "null"] },
        "effective": { "type": ["integer", "null"] },
        "mode": { "type": "string" }
      }
    },
    "stopReason": { "enum": ["budget", "work-ceiling", "search-exhausted", "memory", "time", "cancelled", "error"] },
    "resources": {
      "type": ["object", "null"],
      "required": ["provenance", "limits", "stopReason", "process", "snapshots", "coverageIndexBytes", "peakCoverageIndexBytes"],
      "properties": {
        "provenance": { "enum": ["inkbench-worker", "external-adapter"] },
        "limits": {
          "type": "object",
          "required": ["memoryCapBytes", "searchMemoryLimitBytes", "timeCapMs"],
          "properties": {
            "memoryCapBytes": { "type": ["integer", "null"], "minimum": 1 },
            "searchMemoryLimitBytes": { "type": ["integer", "null"], "minimum": 1 },
            "timeCapMs": { "type": ["integer", "null"], "minimum": 1 }
          }
        },
        "stopReason": { "enum": ["budget", "work-ceiling", "search-exhausted", "memory", "time", "cancelled", "error"] },
        "process": { "type": "object", "required": ["peak", "final"] },
        "snapshots": { "type": ["object", "null"], "required": ["created", "released", "current", "peak", "explicitReferences", "currentBytes", "peakBytes", "checkpointBytes", "peakCheckpointBytes"] },
        "coverageIndexBytes": { "type": ["integer", "null"], "minimum": 0 },
        "peakCoverageIndexBytes": { "type": ["integer", "null"], "minimum": 0 },
        "longRunTelemetry": { "$ref": "#/$defs/longRunTelemetryV1" }
      }
    },
    "runtime": {
      "type": "object",
      "required": ["harnessVersion", "runContractVersion", "engine", "engineVersion", "node", "platform"],
      "properties": {
        "harnessVersion": { "type": "string" },
        "runContractVersion": { "const": "marathon-v4" },
        "engine": { "type": "string" },
        "engineVersion": { "type": "string" },
        "node": { "type": "string" },
        "platform": { "type": "string" }
      }
    },
    "status": { "enum": ["completed", "resource-stopped", "adapter-unavailable", "compile-error", "runtime-error"] },
    "error": { "type": ["string", "null"] },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "longRunSafeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "longRunNullableSafeInteger": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "longRunNullableRate": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "longRunPhaseDurationsV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "setupMs",
        "compilationMs",
        "sourceScanMs",
        "searchActiveMs",
        "minimumReproductionMs",
        "checkpointWriteMs",
        "checkpointReopenMs",
        "replayScoringMs",
        "reportEnrichmentMs",
        "reportWriteMs",
        "finalizationMs"
      ],
      "properties": {
        "setupMs": {
          "$ref": "#/$defs/longRunSafeInteger"
        },
        "compilationMs": {
          "$ref": "#/$defs/longRunSafeInteger"
        },
        "sourceScanMs": {
          "$ref": "#/$defs/longRunSafeInteger"
        },
        "searchActiveMs": {
          "$ref": "#/$defs/longRunSafeInteger"
        },
        "minimumReproductionMs": {
          "$ref": "#/$defs/longRunSafeInteger"
        },
        "checkpointWriteMs": {
          "$ref": "#/$defs/longRunSafeInteger"
        },
        "checkpointReopenMs": {
          "$ref": "#/$defs/longRunSafeInteger"
        },
        "replayScoringMs": {
          "$ref": "#/$defs/longRunSafeInteger"
        },
        "reportEnrichmentMs": {
          "$ref": "#/$defs/longRunSafeInteger"
        },
        "reportWriteMs": {
          "$ref": "#/$defs/longRunSafeInteger"
        },
        "finalizationMs": {
          "$ref": "#/$defs/longRunSafeInteger"
        }
      }
    },
    "longRunLogicalIntegralV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "byteMillisecondsTimesTwo",
        "divisor"
      ],
      "properties": {
        "basis": {
          "const": "deterministic_logical_accounted_bytes"
        },
        "byteMillisecondsTimesTwo": {
          "type": "string",
          "maxLength": 33,
          "pattern": "^(0|[1-9][0-9]{0,32})(?![\\s\\S])"
        },
        "divisor": {
          "const": 2
        }
      }
    },
    "longRunProcessRssIntegralV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "byteMillisecondsTimesTwo",
        "divisor"
      ],
      "properties": {
        "basis": {
          "const": "observed_process_rss_bytes"
        },
        "byteMillisecondsTimesTwo": {
          "type": "string",
          "maxLength": 33,
          "pattern": "^(0|[1-9][0-9]{0,32})(?![\\s\\S])"
        },
        "divisor": {
          "const": 2
        }
      }
    },
    "longRunYieldRateV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identities",
        "identitiesPerMillionTransitions",
        "identitiesPerSearchActiveMinute",
        "identitiesPerRetainedGiBMinute"
      ],
      "properties": {
        "identities": {
          "$ref": "#/$defs/longRunSafeInteger"
        },
        "identitiesPerMillionTransitions": {
          "$ref": "#/$defs/longRunNullableRate"
        },
        "identitiesPerSearchActiveMinute": {
          "$ref": "#/$defs/longRunNullableRate"
        },
        "identitiesPerRetainedGiBMinute": {
          "$ref": "#/$defs/longRunNullableRate"
        }
      }
    },
    "longRunUnobservedYieldRateV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identities",
        "identitiesPerMillionTransitions",
        "identitiesPerSearchActiveMinute",
        "identitiesPerRetainedGiBMinute"
      ],
      "properties": {
        "identities": {
          "const": 0
        },
        "identitiesPerMillionTransitions": {
          "type": "null"
        },
        "identitiesPerSearchActiveMinute": {
          "type": "null"
        },
        "identitiesPerRetainedGiBMinute": {
          "type": "null"
        }
      }
    },
    "longRunYieldRatesV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "critical",
        "intent",
        "authoredCoverage",
        "visibleOutcomes",
        "semanticTransitions",
        "terminalVariants"
      ],
      "properties": {
        "critical": {
          "$ref": "#/$defs/longRunYieldRateV1"
        },
        "intent": {
          "$ref": "#/$defs/longRunYieldRateV1"
        },
        "authoredCoverage": {
          "$ref": "#/$defs/longRunYieldRateV1"
        },
        "visibleOutcomes": {
          "$ref": "#/$defs/longRunYieldRateV1"
        },
        "semanticTransitions": {
          "$ref": "#/$defs/longRunYieldRateV1"
        },
        "terminalVariants": {
          "$ref": "#/$defs/longRunYieldRateV1"
        }
      }
    },
    "longRunUnobservedYieldRatesV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "critical",
        "intent",
        "authoredCoverage",
        "visibleOutcomes",
        "semanticTransitions",
        "terminalVariants"
      ],
      "properties": {
        "critical": {
          "$ref": "#/$defs/longRunUnobservedYieldRateV1"
        },
        "intent": {
          "$ref": "#/$defs/longRunUnobservedYieldRateV1"
        },
        "authoredCoverage": {
          "$ref": "#/$defs/longRunUnobservedYieldRateV1"
        },
        "visibleOutcomes": {
          "$ref": "#/$defs/longRunUnobservedYieldRateV1"
        },
        "semanticTransitions": {
          "$ref": "#/$defs/longRunUnobservedYieldRateV1"
        },
        "terminalVariants": {
          "$ref": "#/$defs/longRunUnobservedYieldRateV1"
        }
      }
    },
    "longRunPassCostV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "pass",
        "samplesObserved",
        "firstObservationElapsedMs",
        "lastObservationElapsedMs",
        "searchActiveMs",
        "transitions",
        "logicalRetained",
        "processRss",
        "yield"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "pass": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:=/-]{1,128}(?![\\s\\S])"
        },
        "samplesObserved": {
          "$ref": "#/$defs/longRunSafeInteger"
        },
        "firstObservationElapsedMs": {
          "$ref": "#/$defs/longRunNullableSafeInteger"
        },
        "lastObservationElapsedMs": {
          "$ref": "#/$defs/longRunNullableSafeInteger"
        },
        "searchActiveMs": {
          "$ref": "#/$defs/longRunSafeInteger"
        },
        "transitions": {
          "$ref": "#/$defs/longRunSafeInteger"
        },
        "logicalRetained": {
          "$ref": "#/$defs/longRunLogicalIntegralV1"
        },
        "processRss": {
          "$ref": "#/$defs/longRunProcessRssIntegralV1"
        },
        "yield": {
          "$ref": "#/$defs/longRunYieldRatesV1"
        }
      },
      "description": "Pass-local costs and yield cover only the first-to-last live observation interval. The runtime validator also checks elapsed-bound differences, ordered sample counts, unique pass labels, and exact rate/denominator relationships; these relations cannot be expressed by this portable JSON Schema.",
      "allOf": [
        {
          "if": {
            "properties": {
              "samplesObserved": {
                "const": 0
              }
            }
          },
          "then": {
            "properties": {
              "firstObservationElapsedMs": {
                "const": null
              },
              "lastObservationElapsedMs": {
                "const": null
              },
              "searchActiveMs": {
                "const": 0
              },
              "transitions": {
                "const": 0
              },
              "logicalRetained": {
                "properties": {
                  "byteMillisecondsTimesTwo": {
                    "const": "0"
                  }
                }
              },
              "processRss": {
                "properties": {
                  "byteMillisecondsTimesTwo": {
                    "const": "0"
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "firstObservationElapsedMs": {
                "$ref": "#/$defs/longRunSafeInteger"
              },
              "lastObservationElapsedMs": {
                "$ref": "#/$defs/longRunSafeInteger"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "samplesObserved": {
                "maximum": 1
              }
            }
          },
          "then": {
            "properties": {
              "searchActiveMs": {
                "const": 0
              },
              "transitions": {
                "const": 0
              },
              "logicalRetained": {
                "properties": {
                  "byteMillisecondsTimesTwo": {
                    "const": "0"
                  }
                }
              },
              "processRss": {
                "properties": {
                  "byteMillisecondsTimesTwo": {
                    "const": "0"
                  }
                }
              },
              "yield": {
                "$ref": "#/$defs/longRunUnobservedYieldRatesV1"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "searchActiveMs": {
                "const": 0
              }
            }
          },
          "then": {
            "properties": {
              "logicalRetained": {
                "properties": {
                  "byteMillisecondsTimesTwo": {
                    "const": "0"
                  }
                }
              },
              "processRss": {
                "properties": {
                  "byteMillisecondsTimesTwo": {
                    "const": "0"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "longRunTelemetryV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "phases",
        "passes"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "phases": {
          "$ref": "#/$defs/longRunPhaseDurationsV1"
        },
        "passes": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/longRunPassCostV1"
          }
        }
      },
      "description": "Optional InkCheck-native schema-v1 observational receipt. Absence means unavailable, not zero cost. Phases may overlap inclusive parents and must not be summed. Passes and rates must not be pooled across overlapping identities; an empty pass list supplies no sampled cost interval. Process RSS integrals are sampled process-scoped costs, not peak RSS or exclusive ownership."
    }
  }
}
