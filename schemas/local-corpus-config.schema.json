{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chaoz23/inkbench/blob/main/schemas/local-corpus-config.schema.json",
  "title": "InkBench private local corpus config v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "corpusId", "cases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "corpusId": { "type": "string", "minLength": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sourceFiles", "entrypoint", "compiledArtifact", "compilerVersion", "license"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "sourceFiles": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
          "entrypoint": { "type": "string" },
          "compiledArtifact": { "type": "string" },
          "compilerVersion": { "type": "string" },
          "license": { "enum": ["MIT", "CC-BY-4.0", "proprietary", "other"] }
        }
      }
    }
  }
}
