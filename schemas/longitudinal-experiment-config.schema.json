{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chaoz23/inkbench/blob/main/schemas/longitudinal-experiment-config.schema.json",
  "title": "InkBench longitudinal experiment config v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sequenceSeeds", "partition", "revisions", "arms", "perRevisionBudget", "storySeed", "maxRoutes", "maxCorpusBytes", "rogueFraction", "periodicRebuildEvery"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sequenceSeeds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer" } },
    "partition": { "enum": ["development", "validation", "evaluation"] },
    "revisions": { "type": "integer", "minimum": 1, "maximum": 30 },
    "arms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["cold-random", "cold-systematic", "cold-coverage", "cold-swarm", "cold-inkcheck", "warm-coverage", "periodic-coverage", "persistent-swarm", "persistent-swarm-no-rogue"] }
    },
    "perRevisionBudget": { "type": "integer", "minimum": 1 },
    "storySeed": { "type": "integer", "minimum": 1 },
    "maxRoutes": { "type": "integer", "minimum": 1 },
    "maxCorpusBytes": { "type": "integer", "minimum": 1024 },
    "rogueFraction": { "type": "number", "minimum": 0, "maximum": 1 },
    "periodicRebuildEvery": { "type": "integer", "minimum": 1 },
    "inkcheckCommand": { "type": "string" }
  }
}
