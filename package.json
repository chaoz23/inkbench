{
  "name": "@chaoz23/inkbench",
  "version": "0.1.0",
  "description": "Neutral, reproducible benchmarks for bug-finding search strategies in Ink stories.",
  "type": "module",
  "bin": {
    "inkbench": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "schemas",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/**/*.test.js",
    "smoke": "node dist/cli.js run --family shallow-obvious --algorithm random --fixture-seed 1 --search-seed 1 --budget 50 --json",
    "experiment:quick": "node dist/cli.js experiment --preset quick --out artifacts/quick",
    "experiment:development": "node dist/cli.js experiment --preset development --out artifacts/development"
  },
  "keywords": [
    "ink",
    "inkle",
    "interactive-fiction",
    "benchmark",
    "fuzzing",
    "testing",
    "coverage"
  ],
  "author": "Daniel Strader (chaoz23)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chaoz23/inkbench.git"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "inkjs": "2.4.0"
  },
  "devDependencies": {
    "@types/node": "26.1.0",
    "typescript": "6.0.3"
  }
}
